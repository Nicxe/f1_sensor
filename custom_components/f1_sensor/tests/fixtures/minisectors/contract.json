  "availability": [
    {
      "context": "matching_live_session",
      "result": "available_after_snapshot"
    },
    {
      "context": "matching_replay_session",
      "result": "available_after_snapshot"
    },
    {
      "context": "live_before_first_segment_payload",
      "result": "loading_then_neutral_empty"
    },
    {
      "context": "spoiler_protected",
      "result": "blocked_without_retained_segment_data"
    },
    {
      "context": "live_delay_changed",
      "result": "new_generation_from_delayed_stream"
    },
    {
      "context": "replay_seek_or_session_changed",
      "result": "discard_generation_then_snapshot"
    },
    {
      "context": "locked_archive_session",
      "result": "unavailable_without_live_fallback"
    },
    {
      "context": "backend_without_minisector_capability",
      "result": "only_minisector_fields_unavailable"
    },
    {
      "context": "all_consumers_hidden_or_removed",
      "result": "unsubscribe_and_release_resource"
    }
