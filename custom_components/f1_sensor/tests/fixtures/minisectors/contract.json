{
  "format_version": 1,
  "protocol": {
    "version": 1,
    "subscribe_command": "f1_sensor/minisectors/subscribe",
    "event_types": [
      "snapshot",
      "delta",
      "reset",
      "unavailable"
    ],
    "event_requirements": {
      "snapshot": ["generation", "sequence", "drivers"],
      "delta": ["generation", "sequence", "drivers"],
      "reset": ["generation", "sequence", "reason", "scope"],
      "unavailable": ["generation", "sequence", "reason"]
    },
    "initial_event": "snapshot",
    "sequence": {
      "snapshot": 0,
      "delta": "previous + 1",
      "gap_action": "unsubscribe_and_resubscribe"
    },
    "resync": "Every subscription starts with a complete snapshot. A client that detects a sequence gap, reconnect, changed generation, or invalid payload discards the affected generation, unsubscribes, and subscribes again.",
    "generation_changes": [
      "integration_reload",
      "session_change",
      "qualifying_part_change",
      "replay_session_change",
      "replay_seek_backwards",
      "live_delay_change",
      "source_restart"
    ],
    "atomic_source_frame": true,
    "lap_boundary": {
      "trigger": "segment_status_reset_frame",
      "number_of_laps_role": "metadata_only",
      "retain_completed_strip_until_reset_frame": true,
      "preserve_new_lap_statuses_from_reset_frame": true
    }
  },
  "limits": {
    "drivers": 32,
    "sectors_per_driver": 3,
    "segments_per_sector": 32,
    "maximum_event_bytes": 32768,
    "maximum_ui_deltas_per_second": 4,
    "maximum_rolling_bytes_per_client_per_second": 16384,
    "rolling_window_seconds": 10
  },
  "status_semantics": [
    {
      "raw": 0,
      "semantic": "neutral",
      "color": "neutral",
      "label_en": "Not set",
      "label_sv": "Inte registrerad",
      "known": true
    },
    {
      "raw": 2048,
      "semantic": "recorded",
      "color": "yellow",
      "label_en": "Recorded",
      "label_sv": "Registrerad",
      "known": true
    },
    {
      "raw": 2049,
      "semantic": "personal_best",
      "color": "green",
      "label_en": "Personal best",
      "label_sv": "Personbästa",
      "known": true
    },
    {
      "raw": 2051,
      "semantic": "overall_best",
      "color": "purple",
      "label_en": "Overall best",
      "label_sv": "Bäst totalt",
      "known": true
    },
    {
      "raw": 2064,
      "semantic": "special",
      "color": "neutral",
      "label_en": "Special status",
      "label_sv": "Särskild status",
      "known": false
    },
    {
      "raw": "other",
      "semantic": "unknown",
      "color": "neutral",
      "label_en": "Unknown status",
      "label_sv": "Okänd status",
      "known": false
    }
  ],
